# Base URL of agroai_crops-agent-api, e.g. https://api.example.com (a trailing /api/v1 is also accepted).
# Read on the server at request time (the browser never talks to the API). NEXT_PUBLIC_API_URL is accepted too.
# If the login can't reach the API, open /diagnostico to see what the panel's server sees.
AGROAI_API_URL=http://localhost:8000
