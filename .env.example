# Base URL of agroai_crops-agent-api, e.g. https://api.example.com (a trailing /api/v1 is also accepted).
# Read only on the server, at runtime: the browser never talks to the API. NEXT_PUBLIC_API_URL is accepted as a
# fallback, but NEXT_PUBLIC_* values are baked in at build time, so changing it requires a redeploy.
AGROAI_API_URL=http://localhost:8000
